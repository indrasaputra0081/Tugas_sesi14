{
  "name": "sauce-demo-appium",
 "scripts": {
    "allure:clean": "rm -rf reports/allure-results reports/allure-report",
"allure:generate": "npx allure generate reports/allure-results -o reports/allure-report --clean",
"allure:open": "npx allure serve reports/allure-results",
"allure": "npm run allure:clean && npm run wdio && npm run allure:generate && npm run allure:open"
},
  "devDependencies": {
    "@wdio/allure-reporter": "^10.1.0",
    "@wdio/appium-service": "^10.1.1",
    "@wdio/cli": "^10.1.0",
    "@wdio/local-runner": "^10.1.0",
    "@wdio/mocha-framework": "^10.1.0",
    "@wdio/spec-reporter": "^10.1.0",
    "allure-commandline": "^2.46.1"
  }
}